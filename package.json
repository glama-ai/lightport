{
  "name": "lightport",
  "version": "1.0.0",
  "description": "A lightweight AI gateway that makes LLM providers OpenAI-compatible.",
  "keywords": [
    "AI gateway",
    "LLM",
    "Lightport",
    "Lightport AI",
    "OpenAI"
  ],
  "homepage": "https://github.com/glama-ai/lightport#readme",
  "bugs": {
    "url": "https://github.com/glama-ai/lightport/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glama-ai/lightport.git"
  },
  "bin": "build/start-server.mjs",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start-server.ts",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "start:node": "node build/start-server.mjs",
    "format": "oxfmt . && oxlint --type-aware --type-check --quiet --fix",
    "lint": "oxlint src/",
    "knip": "knip",
    "test": "dotenv -- vitest run"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@fastify/cors": "^11.4.1",
    "@sentry/core": "^10.78.0",
    "@sentry/node-core": "10.78.0",
    "@smithy/signature-v4": "^5.7.5",
    "@types/bytes": "^3.1.6",
    "@types/yargs": "^17.0.35",
    "avsc": "^5.7.9",
    "bytes": "^3.1.2",
    "eventsource-parser": "^4.1.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "undici": "^8.12.4",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dotenv-cli": "^11.1.0",
    "get-port": "^7.2.0",
    "knip": "^6.44.1",
    "openai": "^7.52.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
